{
  "name": "qadam-flow",
  "version": "2.0.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prebuild": "node tools/scripts/install-bun.js",
    "prepare": "[ ! -d .git ] || husky install",
    "serve:frontend": "turbo run serve --filter=web",
    "serve:backend": "turbo run serve --filter=api",
    "serve:engine": "turbo run serve --filter=@aiqadam/engine",
    "serve:worker": "turbo run serve --filter=worker",
    "push": "turbo run lint && git push",
    "dev": "node tools/scripts/install-bun.js && turbo run serve --filter=web --filter=api --filter=@aiqadam/engine --filter=worker --ui stream",
    "dev:backend": "turbo run serve --filter=api --filter=@aiqadam/engine --ui stream",
    "dev:frontend": "turbo run serve --filter=web --filter=api --filter=@aiqadam/engine --ui stream",
    "start": "node tools/setup-dev.js && npm run dev",
    "test:e2e": "npx playwright test --config=packages/tests-e2e/playwright.config.ts",
    "test:sandbox-e2e": "bash scripts/run-sandbox-e2e.sh",
    "db-migration": "npx turbo run db-migration --filter=api --",
    "check-migrations": "npx turbo run check-migrations --filter=api",
    "check-migration-metadata": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/check-migration-rollback.ts",
    "check-release-migrations": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/check-release-migrations.ts",
    "check-manifest-migrations": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/check-manifest-migrations.ts",
    "rollback": "npm run rollback --workspace=packages/server/api --",
    "lint-all": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "lint-affected": "turbo run lint --affected",
    "lint-dev": "turbo run lint --filter='!@aiqadam/qadam-*' --force -- --fix",
    "test-unit": "turbo run test",
    "test-api": "turbo run check-migrations test-ce --filter=api --concurrency=1",
    "review": "node tools/scripts/review.mjs",
    "cli": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json  packages/cli/src/index.ts",
    "create-qadam": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json  packages/cli/src/index.ts qadams create",
    "create-action": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json  packages/cli/src/index.ts actions create",
    "create-trigger": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json packages/cli/src/index.ts triggers create",
    "sync-qadams": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json packages/cli/src/index.ts qadams sync",
    "qadams": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json packages/cli/src/index.ts qadams",
    "build-qadam": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json packages/cli/src/index.ts qadams build",
    "publish-qadam-to-api": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json packages/cli/src/index.ts qadams publish",
    "publish-qadam": "npx ts-node -r tsconfig-paths/register --project tools/tsconfig.tools.json tools/scripts/qadams/publish-qadam.ts",
    "publish-framework-packages": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/publish-framework-packages.ts",
    "workers": "npx ts-node -r tsconfig-paths/register --project packages/cli/tsconfig.json packages/cli/src/index.ts workers",
    "check-i18n": "node tools/ci/check-i18n.mjs",
    "check-dropdown-defaults": "node tools/ci/check-dropdown-defaults.mjs",
    "check-pause-markers": "node tools/ci/check-pause-markers.mjs",
    "check-required-prop-defaults": "node tools/ci/check-required-prop-defaults.mjs",
    "check-agent-docs": "node tools/ci/check-agent-docs.mjs",
    "bump-translated-qadams": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/qadams/bump-translated-qadams.ts",
    "bump-all-qadams-patch-version": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/qadams/bump-all-qadams-patch-version.ts"
  },
  "private": true,
  "dependencies": {
    "@logtail/pino": "0.5.6",
    "@rollup/wasm-node": "4.21.2",
    "axios": "1.20.0",
    "dotenv": "17.2.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "http-status-codes": "2.2.0",
    "isolated-vm": "7.0.0",
    "jsonwebtoken": "9.0.1",
    "pino-opentelemetry-transport": "3.0.0",
    "rollup": "4.59.0",
    "semver": "7.6.0",
    "sqlite3": "6.0.1",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "17.7.1",
    "@commitlint/config-conventional": "17.7.0",
    "@formatjs/icu-messageformat-parser": "2.7.8",
    "@playwright/test": "1.56.0",
    "@types/node": "24.11.0",
    "@types/semver": "7.5.6",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/utils": "7.18.0",
    "chalk": "4.1.2",
    "concurrently": "8.2.1",
    "esbuild": "0.25.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-import-x": "0.5.2",
    "eslint-plugin-jest-dom": "5.4.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-tailwindcss": "3.17.4",
    "eslint-plugin-testing-library": "6.2.2",
    "eslint-plugin-vitest": "0.5.4",
    "husky": "8.0.3",
    "jsonc-eslint-parser": "2.4.1",
    "lint-staged": "15.2.9",
    "prettier": "2.8.4",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.1",
    "tsx": "4.21.0",
    "turbo": "2.9.14",
    "typescript": "5.5.4",
    "vite-plugin-html": "3.2.2",
    "wait-on": "7.2.0",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.20.0",
    "@rollup/rollup-linux-arm-gnueabihf": "4.20.0",
    "@rollup/rollup-linux-arm64-gnu": "4.20.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/cli",
    "packages/server/engine",
    "packages/web",
    "packages/server/api",
    "packages/server/utils",
    "packages/server/worker",
    "packages/tests-e2e",
    "packages/qadams/framework",
    "packages/qadams/common",
    "packages/qadams/core/*",
    "packages/qadams/community/*",
    "packages/qadams/custom/*"
  ],
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
