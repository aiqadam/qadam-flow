{
  "extends": [
    "../api/.eslintrc.json"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.js"
      ],
      "parserOptions": {
        "project": [
          "tsconfig.*?.json"
        ]
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["lodash", "lodash/*"]
          }
        ],
        "no-restricted-syntax": "off"
      }
    }
  ]
}
