{
  "name": "worker",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "typings": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "serve": "cd ../../.. && npx tsx watch --tsconfig packages/server/worker/tsconfig.lib.json packages/server/worker/src/bootstrap.ts",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiqadam/qadams-framework": "workspace:*",
    "@aiqadam/server-utils": "workspace:*",
    "@aiqadam/shared": "workspace:*",
    "@ai-sdk/amazon-bedrock": "5.0.108",
    "@ai-sdk/mcp": "2.0.69",
    "@ai-sdk/anthropic": "4.0.74",
    "@ai-sdk/azure": "4.0.94",
    "@ai-sdk/google": "4.0.90",
    "@ai-sdk/openai": "4.0.86",
    "@ai-sdk/openai-compatible": "3.0.65",
    "@ai-sdk/provider": "4.0.24",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.130",
    "async-mutex": "0.4.0",
    "dayjs": "1.11.23",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "env-var": "7.5.0",
    "jsonc-parser": "3.3.1",
    "nanoid": "3.3.20",
    "pino": "10.1.0",
    "pino-pretty": "13.0.0",
    "proxy-chain": "2.7.1",
    "socket.io": "4.8.4",
    "dotenv": "17.2.3",
    "socket.io-client": "4.8.4",
    "tree-kill": "1.2.2",
    "tslib": "2.6.2",
    "write-file-atomic": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "@types/write-file-atomic": "4.0.3",
    "esbuild": "0.25.0",
    "vitest": "4.1.11"
  }
}
