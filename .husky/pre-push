#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

if [ -n "${SKIP_CHECK:-}" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "Direct pushes to 'main' are not allowed. Please use a feature branch and a pull request."
        exit 1
    fi
done

if [ -z "${RUN_CHECKS:-}" ] && [ -n "${CI:-}" ] && [ "$CI" != "false" ] && [ "$CI" != "0" ]; then
  RUN_CHECKS="n"
fi
if [ -z "${RUN_CHECKS:-}" ] && [ -t 1 ]; then
  # IDE / CI Git runs with stdout on a pipe, not a TTY — do not prompt (avoids blocking forever on read /dev/tty)
  printf "Run checks before pushing? [Y]es (lint + tests) / [n]o / [l]int only / [r]eview " > /dev/tty
  if read -r RUN_CHECKS < /dev/tty; then
    # Enter (empty answer) accepts the advertised [Y]es default and runs the full gate.
    [ -z "$RUN_CHECKS" ] && RUN_CHECKS="y"
  else
    RUN_CHECKS="n"
  fi
fi
: "${RUN_CHECKS:=n}"

case "$RUN_CHECKS" in
  [nN][oO]|[nN])
    echo "Skipping lint and tests."
    ;;
  [lL][iI][nN][tT]|[lL])
    echo "Running lint-dev (with auto-fix)..."
    npm run lint-dev || { echo ""; echo "Lint failed. Fix the remaining issues and try again."; exit 1; }
    if [ -n "$(git status --porcelain)" ]; then
      echo ""
      echo "lint-dev auto-fixed files. Commit the changes before pushing:"
      git status --short
      exit 1
    fi
    ;;
  [rR][eE][vV][iI][eE][wW]|[rR])
    # Advisory AI review (#444). Deliberately its own branch: it must never run
    # as part of the y/lint gate, and only `critical` findings can stop a push —
    # after an explicit confirmation, because false positives exist.
    echo "Running AI review (advisory)..."
    node tools/scripts/review.mjs
    review_status=$?
    if [ "$review_status" -eq 2 ]; then
      # No TTY means no human to take responsibility for the override — fail
      # closed rather than hanging on /dev/tty or pushing silently.
      if [ -t 1 ]; then
        printf "Critical findings reported above. Push anyway? [y/N] " > /dev/tty
        answer=""
        read -r answer < /dev/tty || answer=""
        case "$answer" in
          [yY]|[yY][eE][sS])
            echo "Pushing anyway."
            ;;
          *)
            echo "Push cancelled. Fix the critical findings, or push again with RUN_CHECKS=n to skip the review."
            exit 1
            ;;
        esac
      else
        echo "Critical findings reported above, and no terminal to confirm a push-anyway. Aborting the push."
        exit 1
      fi
    elif [ "$review_status" -ne 0 ]; then
      echo "Review did not complete (exit $review_status). Advisory only — continuing the push."
    fi
    ;;
  *)
    echo "Running lint..."
    # The complement of the qadams glob, i.e. the same set `lint-dev` fixes, so
    # this covers every non-qadam package including the four that the old
    # `lint-core` list never named. The qadams are covered by `lint-affected`
    # below; linting all 238 of them on every push is not worth the wall clock.
    npx turbo run lint --filter='!@aiqadam/qadam-*' || { echo ""; echo "Lint failed. To auto-fix issues, run:"; echo "  npm run lint-dev"; echo "Or target a specific package:"; echo "  npx turbo run lint --filter=\"<packageName>\" --force -- --fix"; exit 1; }
    npm run lint-affected || { echo ""; echo "Lint failed. To auto-fix issues, run:"; echo "  npm run lint-dev"; echo "Or target a specific package:"; echo "  npx turbo run lint --filter=\"<packageName>\" --force -- --fix"; exit 1; }
    echo "Running typecheck..."
    npm run typecheck || { echo ""; echo "Typecheck failed. Fix the type errors above and try again."; exit 1; }
    echo "Running tests..."
    npm run test-unit || { echo ""; echo "Unit tests failed. Check the output above for details."; exit 1; }
    npm run test-api || { echo ""; echo "API tests failed. Check the output above for details."; exit 1; }
    ;;
esac


