{
  "include": [
    "packages/server/api/test/**/*.ts"
  ],
  "exclude": [
    "docs/**",
    "CHANGELOG.md",
    "**/generated/**",
    "**/i18n/**",
    "packages/web/public/locales/**"
  ],
  "rules": [
    {
      "path": "packages/server/api/src/app/database/migration/**/*.ts",
      "rule": ".opencodereview/rules/10-migrations.md",
      "merge_system_rule": true
    },
    {
      "path": "packages/server/**/*.ts",
      "rule": ".opencodereview/rules/20-server.md",
      "merge_system_rule": true
    },
    {
      "path": "packages/web/**/*.{ts,tsx}",
      "rule": ".opencodereview/rules/30-web.md",
      "merge_system_rule": true
    },
    {
      "path": "packages/shared/**/*.ts",
      "rule": ".opencodereview/rules/40-shared.md",
      "merge_system_rule": true
    },
    {
      "path": "packages/shared/package.json",
      "rule": ".opencodereview/rules/40-shared.md",
      "merge_system_rule": true
    },
    {
      "path": "packages/qadams/**/*.ts",
      "rule": ".opencodereview/rules/60-qadams.md",
      "merge_system_rule": true
    },
    {
      "path": "packages/qadams/{community,core}/*/package.json",
      "rule": ".opencodereview/rules/60-qadams.md",
      "merge_system_rule": true
    },
    {
      "path": "tools/ci/**/*.sh",
      "rule": ".opencodereview/rules/50-ci.md",
      "merge_system_rule": true
    },
    {
      "path": ".github/workflows/**/*.{yml,yaml}",
      "rule": ".opencodereview/rules/50-ci.md",
      "merge_system_rule": true
    },
    {
      "path": ".husky/**",
      "rule": ".opencodereview/rules/50-ci.md",
      "merge_system_rule": true
    },
    {
      "path": "run.sh",
      "rule": ".opencodereview/rules/50-ci.md",
      "merge_system_rule": true
    },
    {
      "path": "**/*.{ts,tsx,js,jsx,mjs,cjs}",
      "rule": ".opencodereview/rules/90-typescript.md",
      "merge_system_rule": true
    }
  ]
}
