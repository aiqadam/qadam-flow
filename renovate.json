{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":gitSignOff"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "3 days",
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "admin@rustamov.me"
  ],
  "labels": ["chore"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The sandbox loads whatever isolated-vm the Dockerfiles install, so these pins must move with the manifests (#810).",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^packages/server/worker/test/e2e/Dockerfile$/",
        "/^\\.devcontainer/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG ISOLATED_VM_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)",
        "bun i isolated-vm@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "isolated-vm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Qadam packages are published on npm and carry a manual version contract (AGENTS.md, 'Published-package version bumps'). Routine dependency updates inside one are left to humans. Security/OSV alerts bypass this file-scoped disable; the version bump such a fix needs is applied by the `Qadam version bumps` workflow (tools/ci/check-qadam-version-bumps.mjs), not by a Renovate rule — Renovate cannot do it here (bumpVersion is npm-only, and the bun manager supersedes npm).",
      "matchFileNames": ["packages/qadams/**"],
      "enabled": false
    },
    {
      "description": "Internal @aiqadam/* packages are versioned by hand and pinned exactly by every published qadam. Do not propose updates for them.",
      "matchPackageNames": ["@aiqadam/*"],
      "enabled": false
    },
    {
      "description": "Minor updates are batched into one PR per run, opened on Mondays. Family rules below override the group name so a family is still never split.",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor-updates",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Patch updates automerge once the required CI checks are green.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "isolated-vm is the sandbox isolation boundary. Its Dockerfile pins must move in one PR with the manifests (see customManagers above), and it must never merge unattended — #771 merged while Docker Image and Sandbox e2e were red (#810).",
      "matchPackageNames": ["isolated-vm"],
      "groupName": "isolated-vm",
      "automerge": false
    },
    {
      "description": "Families that must move together.",
      "matchPackageNames": ["@ai-sdk/*", "ai"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ai-sdk"
    },
    {
      "matchPackageNames": ["@opentelemetry/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "opentelemetry"
    },
    {
      "matchPackageNames": ["@aws-sdk/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "aws-sdk"
    },
    {
      "matchPackageNames": ["@tiptap/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tiptap"
    },
    {
      "matchPackageNames": ["@fastify/*", "fastify"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "fastify"
    },
    {
      "matchPackageNames": ["@typescript-eslint/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "typescript-eslint"
    },
    {
      "matchPackageNames": ["@radix-ui/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "radix-ui"
    },
    {
      "description": "Majors open individually and are labelled tech-debt for triage.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["tech-debt"],
      "automerge": false
    }
  ]
}
