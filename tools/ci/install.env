# Environment that changes what `bun install` PRODUCES, sourced by tools/ci/install-deps.sh.
#
# Why this is a file and not an export in the script: the node_modules cache key hashes this file, so
# editing a value here invalidates the cache, while editing the script's prose does not. Putting the
# exports in install-deps.sh directly would mean either hashing a file that gets touched for comments
# and refactors — a full cold rebuild on every branch each time — or, as was the case, a cache that
# silently serves a tree built under different install behaviour.
#
# So: anything here must be a value that changes the installed tree. Anything that only changes how
# the script reports or retries belongs in the script.

# redis-memory-server's postinstall downloads a Redis binary and, when that download fails, compiles
# Redis from source. That compile is broken, so the postinstall exits 1 and takes the whole install
# with it — see the header of install-deps.sh for why this was invisible until a PR touched bun.lock.
#
# Nothing in CI uses those binaries: tests run against a real Redis service
# (packages/server/api/.env.tests sets AP_REDIS_TYPE=STANDALONE at 127.0.0.1:6379), the integration
# job starts one, and no test constructs RedisMemoryServer. Skipping the compile is therefore the fix
# and not a workaround.
REDISMS_DISABLE_POSTINSTALL=1
