# Acceptance harness: the Mailpit TLS key is generated locally, never committed.
packages/tests-e2e/acceptance/certs/

# CI E2E job: the Mailpit TLS cert it generates for itself (#342) — a runtime artifact of the job,
# never committed. (The CI-only compose overrides that mount it are staged via `COMPOSE_FILE`
# pointing straight at tools/ci/*.docker-compose.yml, not copied into this directory.)
/certs/

# A local redis-server started for the CE tests writes its snapshot into its working directory.
dump.rdb
